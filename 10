

Week-10: Complete MongoDB Program – Step-by-Step Code
Below are all four programs in the exact order you need to write and execute them in your practical exam.
Step 1: Create the Node.js project
Open VS Code terminal and execute:
mkdir Week10_MongoDB
cd Week10_MongoDB
npm init -y
npm install mongodb@4.17.2


Create these four JavaScript files:
Week10_MongoDB/
│
├── demo_create_mongo_db.js
├── demo_mongodb_createcollection.js
├── demo_mongodb_insert_multiple.js
└── demo_mongodb_find.js


Step 2: Create a database
File 1
 demo_create_mongo_db.js
var MongoClient = require('mongodb').MongoClient;

var url = "mongodb://localhost:27017/mydb";

MongoClient.connect(url, function(err, db) {
    if (err) throw err;

    console.log("Database created!");

    db.close();
});


Run:
node demo_create_mongo_db.js


Output:
Database created!


Step 3: Create a collection
File 2
 demo_mongodb_createcollection.js
var MongoClient = require('mongodb').MongoClient;

var url = "mongodb://localhost:27017/";

MongoClient.connect(url, function(err, db) {
    if (err) throw err;

    var dbo = db.db("mydb");

    dbo.createCollection("customers", function(err, res) {
        if (err) throw err;

        console.log("Collection created!");

        db.close();
    });
});


Run:
node demo_mongodb_createcollection.js


Output:
Collection created!


Step 4: Insert multiple documents
File 3
 demo_mongodb_insert_multiple.js
var MongoClient = require('mongodb').MongoClient;

var url = "mongodb://localhost:27017/";

MongoClient.connect(url, function(err, db) {
    if (err) throw err;

    var dbo = db.db("mydb");

    var myobj = [
        { name: 'John', address: 'Highway 71'},
        { name: 'Peter', address: 'Lowstreet 4'},
        { name: 'Amy', address: 'Apple st 652'},
        { name: 'Hannah', address: 'Mountain 21'},
        { name: 'Michael', address: 'Valley 345'},
        { name: 'Sandy', address: 'Ocean blvd 2'},
        { name: 'Betty', address: 'Green Grass 1'},
        { name: 'Richard', address: 'Sky st 331'},
        { name: 'Susan', address: 'One way 98'},
        { name: 'Vicky', address: 'Yellow Garden 2'},
        { name: 'Ben', address: 'Park Lane 38'},
        { name: 'William', address: 'Central st 954'},
        { name: 'Chuck', address: 'Main Road 989'},
        { name: 'Viola', address: 'Sideway 1633'}
